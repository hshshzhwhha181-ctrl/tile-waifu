   "themes": [
    "SAKURA",
    "MOON",
    "JADE",
    "TIDE",
    "INK",
    "EMBER",
    "NEON"
   ],
   "boldness": [
    "B1",
    "B2"
   ],
   "min_voice_lines": 8,
   "min_ult_beats": 6,
   "disk_budget_mb": 12.3
  },
  "ssrp": {
   "hud_level": 2,
   "rank": 3,
   "themes": [
    "SAKURA",
    "MOON",
    "JADE",
    "EMBER",
    "TIDE",
    "NEON",
    "INK",
    "GILT"
   ],
   "boldness": [
    "B1",
    "B2",
    "B3"
   ],
   "min_voice_lines": 20,
   "min_ult_beats": 8,
   "disk_budget_mb": 23.2
  }
 },
 "x-disk-tolerance": 0.15,
 "x-max-file-kb": 2560,
 "x-max-video-kb": 2457,
 "x-slot-registry": {
  "art.card": {
   "kind": "tex",
   "min_tier": 0,
   "class": "E",
   "max_kb": 300,
