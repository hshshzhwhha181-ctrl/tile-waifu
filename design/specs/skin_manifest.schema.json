{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tile-waifu/skin_manifest.schema.json",
 "title": "Tile Waifu SkinPack manifest.json, schema 1",
 "description": "Shape of a skin manifest + rule tables read by tools/qa/skin_lint.py. GENERATED by tools/qa/build_skin_schema.py. Manifest holds NO raw colours (palette refs only), NO fonts, NO scripts, NO geometry.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "id",
  "hero",
  "tier",
  "name_ru",
  "season",
  "hud_level",
  "theme",
  "boldness",
  "pack_ver",
  "engine",
  "min_game",
  "proportions",
  "palette",
  "presence",
  "faces",
  "touch",
  "ult",
  "voice",
  "slots",
  "files",
  "budget",
  "qa",
  "provenance",
  "fallbacks"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9]{1,15}_(base|vow|(s|ssr|ssrp)_[a-z0-9]{3,16})$"
  },
  "hero": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9]{1,15}$"
  },
  "tier": {
   "enum": [
    "base",
    "vow",
    "s",
    "ssr",
    "ssrp"
   ]
  },
  "name_ru": {
   "type": "string",
   "minLength": 2,
   "maxLength": 24
  },
  "season": {
   "type": "string",
   "pattern": "^(launch|S[1-9][0-9]?)$"
  },
  "hud_level": {
   "enum": [
    0,
    1,
    2
   ]
  },
  "theme": {
   "enum": [
    "SAKURA",
    "MOON",
    "JADE",
    "EMBER",
    "TIDE",
    "NEON",
    "INK",
    "GILT",
    null
   ]
  },
  "boldness": {
   "enum": [
    "B1",
    "B2",
    "B3"
   ]
  },
  "pack_ver": {
   "type": "string",
   "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
  },
  "engine": {
   "type": "string",
   "pattern": "^4\\.[0-9]+\\.x$"
  },
  "min_game": {
   "type": "string",
   "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
  },
  "proportions": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "heads",
    "height_cm"
   ],
   "properties": {
    "heads": {
     "type": "number",
     "minimum": 6.75,
     "maximum": 8.0
    },
    "height_cm": {
     "type": "number",
     "minimum": 150,
     "maximum": 190
    }
   }
  },
  "palette": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "hero",
    "theme",
    "slots"
   ],
   "properties": {
    "hero": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9]{1,15}$"
    },
    "theme": {
     "enum": [
      "SAKURA",
      "MOON",
      "JADE",
      "EMBER",
      "TIDE",
      "NEON",
      "INK",
      "GILT",
      null
     ]
    },
    "slots": {
     "type": "object",
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "additionalProperties": {
      "type": "string",
      "pattern": "^(NIGHT_(900|800|700|600|500|400)|PLATE_RIM|PLATE_SPARK|H(100|300|500|700|900)|T[1-5])$|^NIGHT_(800|700|600)\\+(T5|H900)@0\\.[0-9]{1,2}$"
     },
     "maxProperties": 40
    }
   }
  },
  "dyes": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "theme",
     "slots"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^dye_[1-3]$"
     },
     "theme": {
      "enum": [
       "SAKURA",
       "MOON",
       "JADE",
       "EMBER",
       "TIDE",
       "NEON",
       "INK",
       "GILT"
      ]
     },
     "slots": {
      "type": "object",
      "propertyNames": {
       "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
       "type": "string",
       "pattern": "^(NIGHT_(900|800|700|600|500|400)|PLATE_RIM|PLATE_SPARK|H(100|300|500|700|900)|T[1-5])$|^NIGHT_(800|700|600)\\+(T5|H900)@0\\.[0-9]{1,2}$"
      },
      "maxProperties": 40
     }
    }
   }
  },
  "presence": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "full",
    "std",
    "min"
   ],
   "properties": {
    "full": {
     "$ref": "#/$defs/crop"
    },
    "std": {
     "$ref": "#/$defs/crop"
    },
    "min": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "medallion"
     ],
     "properties": {
      "medallion": {
       "type": "string",
       "pattern": "^art/[a-z0-9_]+\\.webp$"
      }
     }
    }
   }
  },
  "rig": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scene",
    "bones",
    "polys",
    "verts"
   ],
   "properties": {
    "scene": {
     "type": "string",
     "pattern": "^rig/[a-z0-9_]+\\.tscn$"
    },
    "bones": {
     "type": "integer",
     "minimum": 1,
     "maximum": 54
    },
    "polys": {
     "type": "integer",
     "minimum": 1,
     "maximum": 64
    },
    "verts": {
     "type": "integer",
     "minimum": 1,
     "maximum": 2900
    },
    "spring_chains": {
     "type": "integer",
     "minimum": 0,
     "maximum": 12
    },
    "spring_bones": {
     "type": "integer",
     "minimum": 0,
     "maximum": 40
    },
    "fps_full": {
     "enum": [
      30,
      60
     ]
    },
    "fps_std": {
     "enum": [
      30,
      60
     ]
    }
   }
  },
  "faces": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]*$"
   },
   "minItems": 4,
   "maxItems": 40,
   "uniqueItems": true
  },
  "touch": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "zones",
    "reactions"
   ],
   "properties": {
    "zones": {
     "type": "integer",
     "minimum": 1,
     "maximum": 16
    },
    "reactions": {
     "type": "integer",
     "minimum": 1,
     "maximum": 64
    },
    "gestures": {
     "type": "integer",
     "minimum": 0,
     "maximum": 16
    }
   }
  },
  "ult": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "beats",
    "short",
    "rig_clip",
    "name_key"
   ],
   "properties": {
    "beats": {
     "type": "integer",
     "minimum": 1,
     "maximum": 12
    },
    "full": {
     "type": "string",
     "pattern": "^ult/[a-z0-9_]+\\.ogv$"
    },
    "short": {
     "type": "string",
     "pattern": "^ult/[a-z0-9_]+\\.(ogv|res)$"
    },
    "rig_clip": {
     "type": "string",
     "pattern": "^ult/[a-z0-9_]+\\.res$"
    },
    "name_key": {
     "type": "string",
     "pattern": "^ult\\.[a-z]+\\.[a-z0-9_]+$"
    }
   }
  },
  "voice": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "lines"
   ],
   "properties": {
    "lines": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "bond",
       "subtitle_key"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,40}$"
       },
       "bond": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10
       },
       "tags": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^[a-z_]+$"
        }
       },
       "subtitle_key": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]*$"
       }
      }
     }
    }
   }
  },
  "audio": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "sting_equip": {
     "type": "string"
    },
    "sting_ult": {
     "type": "string"
    },
    "sfx": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "string"
     }
    },
    "loop_menu": {
     "type": "string"
    }
   }
  },
  "slots": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[a-z]{2,3}\\.[a-z0-9_.]+$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "file",
     "kind",
     "fallback"
    ],
    "properties": {
     "file": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*\\.(webp|png|ogv|ogg|res|tres|tscn|json)$",
      "maxLength": 96
     },
     "kind": {
      "enum": [
       "tex",
       "tex9",
       "anim",
       "video",
       "rig",
       "audio",
       "particles",
       "clip"
      ]
     },
     "w": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
     },
     "h": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
     },
     "nine": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0,
       "maximum": 512
      },
      "minItems": 4,
      "maxItems": 4
     },
     "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
     },
     "loop": {
      "type": "boolean"
     },
     "mem_kb": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
     },
     "fallback": {
      "enum": [
       "base",
       "global",
       "vector"
      ]
     }
    }
   }
  },
  "files": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "bytes",
     "sha256",
     "status"
    ],
    "properties": {
     "path": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*\\.[a-z0-9]{2,5}$",
      "maxLength": 96
     },
     "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2621440
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "status": {
      "enum": [
       "approved",
       "pending",
       "rejected"
      ]
     }
    }
   }
  },
  "budget": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "disk_mb",
    "vram_lobby_mb",
    "vram_match_mb"
   ],
   "properties": {
    "disk_mb": {
     "type": "number",
     "minimum": 0,
     "maximum": 40
    },
    "vram_lobby_mb": {
     "type": "number",
     "minimum": 0,
     "maximum": 60
    },
    "vram_match_mb": {
     "type": "number",
     "minimum": 0,
     "maximum": 30
    },
    "particles_full": {
     "type": "integer",
     "minimum": 0,
     "maximum": 200
    }
   }
  },
  "qa": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "adult_face",
    "red_line",
    "palette_lint",
    "ocr"
   ],
   "properties": {
    "adult_face": {
     "$ref": "#/$defs/signoff"
    },
    "red_line": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "by",
      "date"
     ],
     "properties": {
      "by": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 2
       },
       "minItems": 2,
       "uniqueItems": true
      },
      "date": {
       "$ref": "#/$defs/date"
      }
     }
    },
    "palette_lint": {
     "enum": [
      "pass",
      "fail",
      "pending"
     ]
    },
    "ocr": {
     "enum": [
      "pass",
      "fail",
      "pending"
     ]
    },
    "perf": {
     "type": "object"
    }
   }
  },
  "provenance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tool",
    "prompt_log_sha256",
    "metadata_scrubbed"
   ],
   "properties": {
    "tool": {
     "type": "string",
     "maxLength": 40
    },
    "element": {
     "type": "string",
     "maxLength": 40
    },
    "prompt_log_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "ad_pass": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "metadata_scrubbed": {
     "const": true
    }
   }
  },
  "release": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "banner": {
     "type": "string"
    },
    "announce": {
     "type": "string"
    },
    "direct_sale_from_day": {
     "type": "integer"
    }
   }
  },
  "fallbacks": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "hero_base",
    "global",
    "vector"
   ],
   "properties": {
    "hero_base": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[a-z][a-z0-9]{1,15}_base$"
    },
    "global": {
     "const": "five_winds"
    },
    "vector": {
     "const": true
    }
   }
  }
 },
 "$defs": {
  "crop": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "crop"
   ],
   "properties": {
    "crop": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    }
   }
  },
  "date": {
   "type": "string",
   "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
  },
  "signoff": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "by",
    "date"
   ],
   "properties": {
    "by": {
     "type": "string",
     "minLength": 2
    },
    "date": {
     "$ref": "#/$defs/date"
    }
   }
  }
 },
 "x-tiers": [
  "base",
  "vow",
  "s",
  "ssr",
  "ssrp"
 ],
