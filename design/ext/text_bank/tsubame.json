      "max_words": 12
    },
    {
      "id": "tsubame_touch_hand_1",
      "slot": "touch_hand",
      "tier": "beta24",
      "text": "Вот запечатанный конверт. Забирай… вместе с моей ладонью, если хочешь.",
      "emotion": "shy",
      "max_words": 12
    },
    {
      "id": "tsubame_touch_hair_1",
      "slot": "touch_hair",
      "tier": "beta24",
      "text": "Алый шнур на хвосте держит удачу — завяжи его покрепче.",
