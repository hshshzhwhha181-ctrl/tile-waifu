      "max_words": 12
    },
    {
      "id": "tsubame_touch_outfit_1",
      "slot": "touch_outfit",
      "tier": "beta24",
      "text": "Не тяни мой алый шарф, я же за него прячусь!",
      "emotion": "shy",
      "max_words": 12
    },
    {
      "id": "tsubame_touch_spam_1",
      "slot": "touch_spam",
      "tier": "beta24",
      "text": "Исчезну в дымке! Хватит проверять рефлексы куноити!",
