  "lines": [
    {
      "id": "tsubame_login_morning_1",
      "slot": "login_morning",
      "tier": "beta24",
      "text": "Утренняя почта доставлена. Ждала тебя на крыше с рассвета.",
      "emotion": "neutral",
      "max_words": 12
    },
    {
      "id": "tsubame_login_evening_1",
      "slot": "login_evening",
      "tier": "beta24",
      "text": "Ночь — моё время. Составишь компанию тихой ласточке?",
      "emotion": "warm",
      "max_words": 12
    },
    {
      "id": "tsubame_intro_summon_1",
      "slot": "intro_summon",
      "tier": "beta24",
      "text": "Я Цубамэ, курьер между мирами. Письмо адресовано лично тебе.",
      "emotion": "confident",
      "max_words": 12
    },
    {
      "id": "tsubame_outfit_equip_1",
      "slot": "outfit_equip",
      "tier": "beta24",
      "text": "Лёгкий крой, движений не стесняет. …Тебе правда нравится?",
      "emotion": "shy",
      "max_words": 12
    },
    {
      "id": "tsubame_idle_1",
      "slot": "idle_1",
      "tier": "beta24",
      "text": "Кручу кунай-ласточку и сверяю маршруты. Скоро начнём партию?",
      "emotion": "neutral",
      "max_words": 12
    },
    {
      "id": "tsubame_idle_2",
      "slot": "idle_2",
      "tier": "beta24",
      "text": "Я нашла письмо без подписи… Нет, это точно не моё!",
      "emotion": "shy_averted",
      "max_words": 12
    },
    {
      "id": "tsubame_idle_warm_1",
      "slot": "idle_warm",
      "tier": "beta24",
      "text": "Сквозь любые миры мой маршрут всё равно ведёт к тебе.",
