  "lines": [
    {
      "id": "mc_login_morning_1",
      "slot": "login_morning",
      "tier": "beta24",
      "text": "Доброе утро! Салон открыт, и я уже перемешала фишки для тебя.",
      "emotion": "happy",
      "max_words": 12
    },
    {
      "id": "mc_login_evening_1",
      "slot": "login_evening",
      "tier": "beta24",
      "text": "Наконец-то вернулся! Вечер длинный, сыграем партию на желание?",
      "emotion": "tease",
      "max_words": 12
    },
    {
      "id": "mc_intro_summon_1",
      "slot": "intro_summon",
      "tier": "beta24",
      "text": "Я Маджонг-тян, хозяйка «Пяти ветров». Готов стать моим равным партнёром?",
      "emotion": "confident",
      "max_words": 12
    },
    {
      "id": "mc_outfit_equip_1",
      "slot": "outfit_equip",
      "tier": "beta24",
      "text": "Ну как тебе образ? Только не проигрывай, заглядевшись на меня~",
      "emotion": "tease",
      "max_words": 12
    },
    {
      "id": "mc_idle_1",
      "slot": "idle_1",
      "tier": "beta24",
      "text": "Кручу фишку Востока и жду, когда ты сделаешь первый ход.",
      "emotion": "neutral",
      "max_words": 12
    },
    {
      "id": "mc_idle_2",
      "slot": "idle_2",
      "tier": "beta24",
      "text": "Налила свежего чаю — садись поближе, обсудим нашу тактику.",
      "emotion": "warm",
      "max_words": 12
    },
    {
      "id": "mc_idle_warm_1",
      "slot": "idle_warm",
      "tier": "beta24",
      "text": "За моим столом мне нужен только один соперник — ты.",
      "emotion": "warm",
      "max_words": 12
    },
    {
      "id": "mc_touch_head_1",
      "slot": "touch_head",
      "tier": "beta24",
      "text": "Эй, причёска! Хвосты же подпрыгнут — гладь аккуратнее, ладно?",
      "emotion": "surprised",
      "max_words": 12
    },
    {
      "id": "mc_touch_hand_1",
      "slot": "touch_hand",
      "tier": "beta24",
      "text": "Лови фишку Востока! Хотя руку можешь пока не отпускать.",
      "emotion": "tease",
      "max_words": 12
    },
    {
      "id": "mc_touch_hair_1",
      "slot": "touch_hair",
      "tier": "beta24",
      "text": "Нефритовые узлы я вязала сама — не развяжи случайно!",
      "emotion": "shy",
      "max_words": 12
    },
    {
      "id": "mc_touch_outfit_1",
      "slot": "touch_outfit",
      "tier": "beta24",
      "text": "Не тяни за рукав ципао, иначе я выиграю без поддавков!",
      "emotion": "pout",
      "max_words": 12
    },
    {
      "id": "mc_touch_spam_1",
      "slot": "touch_spam",
      "tier": "beta24",
      "text": "Хватит дразнить хозяйку салона! Я тебе не игровая фишка!",
      "emotion": "pout",
      "max_words": 12
    },
    {
      "id": "mc_touch_bold_1",
      "slot": "touch_bold",
      "tier": "beta24",
      "text": "Когда ты так близко, даже мне трудно думать о партии.",
