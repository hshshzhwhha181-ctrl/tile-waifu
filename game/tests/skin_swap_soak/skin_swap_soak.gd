class_name TWSkinSwapSoak
extends RefCounted

# skin_swap_soak (design/specs/UNIFIED_QA_PLAN.md section 4, test T-SOAK-1):  godot --headless --path game res://tests/skin_swap_soak/skin_swap_soak.tscn
# Prints "TWSKINSOAK_SELFTEST ok/total OK pending=N". Exit 0 when all pass. Pending items are NOT failures: they are the checks that need the
# P-skin package (TWSkinHost / TWPalette / TWSkinPerf / pack mount) and are listed one per line "TWSKINSOAK PENDING ...".
#
# What it does
#   * builds N_MANIFESTS synthetic skin manifests (all tiers x themes x 10 heroines, deterministic RNG seed 7) + loads 2 real fixtures
#     (valid sample, invalid-hex sample) from res://tests/fixtures/skins/
#   * swaps through them N_SWAPS times via TWSkinHostStub -> TWSkin.apply (the REAL shell token layer) -> group "tw_skinned" -> TWBus
#   * after every swap checks: current id, revision +1, every override visible, NO leak of the previous skin, locked tokens untouched,
#     overrides only from slots of that HUD level, exactly 1 _skin_changed per live widget, a skin.committed event
#   * every 25th swap injects a BAD manifest (hex / locked slot / wrong HUD level / unknown slot): must be rejected ATOMICALLY
#     (TWSkin.current, revision and overrides identical to before) and published as skin.failed with the right code
#   * replay determinism (same seed => same FNV-1a hash of the whole swap history; other seed => other hash)
#   * no growth: object count, node count and static memory after a warm-up
#   * reset() returns to the base style
# Gap found while writing it (documented, G-01): TWSkin.apply itself accepts ANY existing token incl. BTN_CASH_* / PAPER_*; the lock must live in TWSkinHost.

const FIX: = "res://tests/fixtures/skins/"
const N_MANIFESTS: = 60
const N_SWAPS_DEFAULT: = 300
const WARMUP: = 30
const BAD_EVERY: = 25
const SEED: = 7
const MAX_OBJECT_GROWTH: = 40            # [ГИПОТЕЗА] verify: run with N_SWAPS=3000 and watch the slope, tighten to 0..10
const MAX_STATIC_GROWTH_BYTES: = 1500000  # [ГИПОТЕЗА]
const P95_SWAP_USEC: = 20000             # [ГИПОТЕЗА] logic-only budget on software GL; the real budget is "commit <= 400 ms" (SKIN_HUD_SYSTEM 4.10)

var checks: = 0
var fails: = 0
var pending: Array = []
var _host: Node
var _data: Dictionary = {}
var _manifests: Array = []
var _bus: = TWBus.new()
var _probes: Array = []
var _plates: Array = []
var _base: Dictionary = {}            # TOKEN -> base Color, read once from TWTokens
var n_swaps: = N_SWAPS_DEFAULT        # nightly: --soak_swaps=3000 (user arg after "--")


class Probe extends Node:
	var hits: = 0

	func _skin_changed() -> void:
		hits += 1


func ok(cond: bool, what: String) -> void:
	checks += 1
	if not cond:
		fails += 1
		print("TWSKINSOAK FAIL: ", what)


func todo(what: String) -> void:
	pending.append(what)
	print("TWSKINSOAK PENDING ", what)


func run(host: Node) -> Array:
	_host = host
	for a in OS.get_cmdline_user_args():
		if (a as String).begins_with("--soak_swaps="):
			n_swaps = clampi(int((a as String).get_slice("=", 1)), 60, 100000)
	TWSkin.reset()
	_load()
	_fixtures()
	_synthetic()
	_stub_contract()
	_widgets()
	await _soak()
	_replay()
	_reset()
	_pending_list()
	_cleanup()
	print("TWSKINSOAK_SELFTEST %d/%d %s pending=%d" % [checks - fails, checks, "OK" if fails == 0 else "FAILED", pending.size()])
	return [checks - fails, checks]


# ------------------------------------------------------------------ data

func _read_json(path: String) -> Variant:
	var f: = FileAccess.open(path, FileAccess.READ)
	if f == null:
		return null
	return JSON.parse_string(f.get_as_text())


func _load() -> void:
	var d: Variant = _read_json(FIX + "ramps_min.json")
	ok(d is Dictionary, "ramps_min.json loads (generated by tools/qa/build_skin_schema.py)")
	_data = d if d is Dictionary else {}
	ok(_data.get("heroes", {}).size() >= 10 and _data.get("themes", {}).size() == 8, "10+ heroine ramps and the 8 themes are present")
	ok(_data.get("slots", {}).size() >= 28, "slot table has >= 28 colour slots")


func _fixtures() -> void:
	var v: Variant = _read_json(FIX + "valid_yue_ssr_scalearmor.json")
	var b: Variant = _read_json(FIX + "invalid_hex_yue_ssr_hexrim.json")
	ok(v is Dictionary and b is Dictionary, "sample manifests load")
	var r: = TWSkinHostStub.resolve(v, _data)
	ok(r["ok"], "valid sample resolves: errors=%s" % [(r["detail"] as Array).slice(0, 4)])
	ok((r["overrides"] as Dictionary).has("PLATE_RIM") and (r["overrides"] as Dictionary).has("BTN_PLAY_MID"),
		"valid sample overrides PLATE_RIM and BTN_PLAY_MID")
	var rb: = TWSkinHostStub.resolve(b, _data)
	ok(not rb["ok"] and (rb["errors"] as Array).has("SL-PAL-01"), "invalid-hex sample is rejected with SL-PAL-01: %s" % [rb["errors"]])
	var before: = TWSkin.revision
	var res: = TWSkinHostStub.swap(b, _data, _bus)
	ok(not res["ok"] and TWSkin.revision == before and TWSkin.current == "", "rejected sample leaves TWSkin untouched (atomic)")
	_manifests.append(v)


func _synthetic() -> void:
	var rng: = RandomNumberGenerator.new()
	rng.seed = SEED
	var heroes: Array = (_data["heroes"] as Dictionary).keys()
	heroes.sort()
	var tiers: Array = ["base", "vow", "s", "ssr", "ssrp"]
	for i in N_MANIFESTS:
		var tier: String = tiers[i % tiers.size()]
		var tr: Dictionary = _data["tiers"][tier]
		var level: int = int(tr["hud_level"])
		var themes: Array = tr["themes"]
		var theme: Variant = themes[rng.randi() % themes.size()] if level > 0 else null
		var hero: String = heroes[rng.randi() % heroes.size()]
		var slots: = {}
		for slot in (_data["slots"] as Dictionary).keys():
			var rule: Dictionary = _data["slots"][slot]
			if not TWSkinHostStub.has_level(rule["levels"], level):
				continue
			var from: Array = []
			for ref in rule["from"]:
				var is_theme: bool = (ref as String).begins_with("T") and (ref as String).length() == 2
				if is_theme and theme == null:
					continue
				from.append(ref)
			if from.is_empty():
				continue
			var pick: String = from[rng.randi() % from.size()]
			if rule.has("mix") and rng.randf() < 0.6:
				var tints: Array = []
				for tt in rule["mix"]:
					if not ((tt as String).begins_with("T") and theme == null):
						tints.append(tt)
				if not tints.is_empty():
					pick = "%s+%s@%.2f" % [pick, tints[rng.randi() % tints.size()], rng.randf_range(0.01, float(rule["mix_max"]))]
			slots[slot] = pick
		_manifests.append({"id": "%s_%s_syn%02d" % [hero, tier, i], "hero": hero, "tier": tier, "hud_level": level,
			"theme": theme, "palette": {"hero": hero, "theme": theme, "slots": slots}})
	ok(_manifests.size() == N_MANIFESTS + 1, "%d synthetic + 1 real manifest built" % N_MANIFESTS)
	var all_ok: = true
	for m in _manifests:
		var r: = TWSkinHostStub.resolve(m, _data)
		if not r["ok"]:
			all_ok = false
			print("TWSKINSOAK synthetic manifest rejected: ", m["id"], " ", (r["detail"] as Array).slice(0, 4))
	ok(all_ok, "every synthetic manifest resolves cleanly through the slot whitelist")
	var min_slots: = 99
	for m in _manifests:
		min_slots = mini(min_slots, (m["palette"]["slots"] as Dictionary).size())
	ok(min_slots >= 6, "no synthetic manifest is trivially empty (smallest has %d colour slots)" % min_slots)


func _stub_contract() -> void:
	var good: Dictionary = (_manifests[1] as Dictionary).duplicate(true)
	for bad in _bad_variants(good):
		var r: = TWSkinHostStub.resolve(bad["m"], _data)
		ok(not r["ok"] and (r["errors"] as Array).has(bad["code"]), "bad variant '%s' -> %s (got %s)" % [bad["name"], bad["code"], r["errors"]])
	# the lock list is real: every locked token exists in TWTokens (a typo here would silently unlock it)
	for tok in _data["locked_tokens"]:
		ok(TWSkin.has_token(tok), "locked token %s exists in TWTokens" % tok)
	# gap G-01: TWSkin.apply alone does not protect locked tokens (the host must)
	TWSkin.apply("g01", {"BTN_CASH_TOP": TWTokens.ROSE_500})
	ok(TWSkin.c("BTN_CASH_TOP") == TWTokens.ROSE_500, "G-01 documented: raw TWSkin.apply accepts a locked token (lock is the host's job)")
	TWSkin.reset()
	# slot-table constants that TWTokens does not have yet (RFC PAL-0001) are reported, not silently dropped
	var r2: = TWSkinHostStub.resolve(_manifests[0], _data)
	ok((r2["pending_tokens"] as Array).size() > 0 and (r2["pending_tokens"] as Array).has("TAB_ACTIVE"),
		"slot table names constants missing in TWTokens (pending PAL-0001): %s" % [r2["pending_tokens"]])


# four ways a manifest can try to cheat, each with the code that must reject it
func _bad_variants(m: Dictionary) -> Array:
	var out: Array = []
	var a: = m.duplicate(true)
	(a["palette"]["slots"] as Dictionary)["rim_spark"] = "#" + "FF00AA"    # built at runtime: tools/lint_tokens.py NO_RAW_HEX must not count a deliberate bad sample
	out.append({"name": "raw hex", "m": a, "code": "SL-PAL-01"})
	var b: = m.duplicate(true)
	(b["palette"]["slots"] as Dictionary)["btn_cash_top"] = "H500"
	out.append({"name": "locked slot btn_cash_top", "m": b, "code": "SL-PAL-04"})
	var c: = m.duplicate(true)
	(c["palette"]["slots"] as Dictionary)["sidebar_glow"] = "H300"
	out.append({"name": "unknown slot", "m": c, "code": "SL-PAL-02"})
	var d: = m.duplicate(true)
	(d["palette"]["slots"] as Dictionary)["rim_spark"] = "PLATE_RIM"    # not a source of rim_spark
	out.append({"name": "forbidden source", "m": d, "code": "SL-PAL-02"})
	var e: = m.duplicate(true)
	e["hud_level"] = 0
	(e["palette"]["slots"] as Dictionary)["felt_hi"] = "T4"           # L2-only slot on an L0 skin
	out.append({"name": "slot above HUD level", "m": e, "code": "SL-PAL-02"})
	return out


# ------------------------------------------------------------------ live widgets

func _widgets() -> void:
	for i in 3:
		var p: = Probe.new()
		p.add_to_group(TWSkin.GROUP)
		_host.add_child(p)
		_probes.append(p)
	for w in [328, 400]:
		var pl: = TWPlate.make("M", w, "soak")
		_host.add_child(pl)
		_plates.append(pl)
	ok(_probes.size() == 3 and _plates.size() == 2, "3 probes + 2 real TWPlate live in group tw_skinned")


# ------------------------------------------------------------------ the soak

func _token_names() -> Array:
	var names: Array = []
	var all: Dictionary = (TWTokens.new().get_script() as Script).get_script_constant_map()
	for k in all:
		if all[k] is Color:
			names.append(k)
			_base[k] = all[k]
	names.sort()
	return names


func _history_hash(h: int, id: String, ov: Dictionary) -> int:
	var s: = id
	var keys: Array = ov.keys()
	keys.sort()
	for k in keys:
		s += "|%s=%s" % [k, (ov[k] as Color).to_html(false)]
	for ch in s.to_utf8_buffer():
		h = ((h ^ int(ch)) * 16777619) & 0xFFFFFFFF
	return h


func _run_sequence(seed_: int, n: int, with_checks: bool) -> Dictionary:
	var rng: = RandomNumberGenerator.new()
	rng.seed = seed_
	var hist: = 2166136261
	var tokens: Array = _token_names()
	var usec: Array = []
	var committed: = 0
	var rejected: = 0
	var obj0: = 0
	var node0: = 0
	var mem0: = 0
	for i in n:
		if i == WARMUP and with_checks:
			obj0 = int(Performance.get_monitor(Performance.OBJECT_COUNT))
			node0 = int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT))
			mem0 = int(Performance.get_monitor(Performance.MEMORY_STATIC))
		var m: Dictionary = _manifests[rng.randi() % _manifests.size()]
		var inject: = (i % BAD_EVERY) == BAD_EVERY - 1
		if inject:
			var variants: Array = _bad_variants(m)
			var v: Dictionary = variants[rng.randi() % variants.size()]
			var snap_id: = TWSkin.current
			var snap_rev: = TWSkin.revision
			var snap_ov: = TWSkin.overrides()
			var res: = TWSkinHostStub.swap(v["m"], _data, _bus)
			rejected += 1
			if with_checks:
				ok(not res["ok"] and res["code"] == v["code"], "swap %d: bad manifest '%s' rejected with %s (got %s)" % [i, v["name"], v["code"], res["code"]])
				ok(TWSkin.current == snap_id and TWSkin.revision == snap_rev and TWSkin.overrides() == snap_ov, "swap %d: rejection is atomic (state identical)" % i)
				var last: Dictionary = _bus.recent(1)[0]
				ok(last.get("t", "") == "skin.failed" and last.get("code", "") == v["code"], "swap %d: skin.failed event with code" % i)
			continue
		var rev0: = TWSkin.revision
		var hits0: Array = []
		for p in _probes:
			hits0.append(p.hits)
		var t0: = Time.get_ticks_usec()
		var r: = TWSkinHostStub.swap(m, _data, _bus)
		usec.append(Time.get_ticks_usec() - t0)
		committed += 1
		hist = _history_hash(hist, m["id"], r["overrides"])
		if not with_checks:
			continue
		ok(r["ok"], "swap %d: %s committed" % [i, m["id"]])
		ok(TWSkin.current == m["id"] and TWSkin.revision == rev0 + 1, "swap %d: current=id and revision+1" % i)
		var ov: Dictionary = r["overrides"]
		var seen_ok: = true
		var leak: = false
		var locked_ok: = true
		for tok in tokens:
			var expect: Color = ov[tok] if ov.has(tok) else _base[tok]
			if TWSkin.c(tok) != expect:
				if ov.has(tok):
					seen_ok = false
				else:
					leak = true
			if (_data["locked_tokens"] as Array).has(tok) and TWSkin.c(tok) != _base[tok]:
				locked_ok = false
		ok(seen_ok, "swap %d: every override is visible through TWSkin.c" % i)
		ok(not leak, "swap %d: no token of the previous skin leaks into %s" % [i, m["id"]])
		ok(locked_ok and TWSkin.rejected == 0, "swap %d: locked tokens untouched, nothing rejected by TWSkin" % i)
		ok(_within_level(ov, int(m["hud_level"])), "swap %d: overrides only come from slots of HUD level L%d" % [i, int(m["hud_level"])])
		var hit_ok: = true
		for j in _probes.size():
			if _probes[j].hits != hits0[j] + 1:
				hit_ok = false
		ok(hit_ok, "swap %d: each live widget got exactly one _skin_changed" % i)
		var ev: Dictionary = _bus.recent(1)[0]
		ok(ev.get("t", "") == "skin.committed" and ev.get("skin", "") == m["id"], "swap %d: skin.committed published" % i)
	return {"hash": hist, "usec": usec, "committed": committed, "rejected": rejected, "obj0": obj0, "node0": node0, "mem0": mem0}


func _within_level(ov: Dictionary, level: int) -> bool:
	var allowed: = {}
	for slot in _data["slots"]:
		var rule: Dictionary = _data["slots"][slot]
		if TWSkinHostStub.has_level(rule["levels"], level):
			for tok in rule["tokens"]:
				allowed[tok] = true
	for tok in ov:
		if not allowed.has(tok):
			return false
	return true


func _soak() -> void:
	var pub0: = _bus.published
	var r: = _run_sequence(SEED, n_swaps, true)
	await _host.get_tree().process_frame
	var obj1: = int(Performance.get_monitor(Performance.OBJECT_COUNT))
	var node1: = int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT))
	var mem1: = int(Performance.get_monitor(Performance.MEMORY_STATIC))
	ok(r["committed"] + r["rejected"] == n_swaps, "soak ran %d steps (%d committed, %d rejected)" % [n_swaps, r["committed"], r["rejected"]])
	ok(r["rejected"] >= n_swaps / BAD_EVERY - 1, "the soak really injected bad manifests (%d)" % r["rejected"])
	ok(obj1 - int(r["obj0"]) <= MAX_OBJECT_GROWTH, "no object growth after warm-up: %d -> %d (<= +%d)" % [r["obj0"], obj1, MAX_OBJECT_GROWTH])
	ok(node1 == int(r["node0"]), "node count constant after warm-up: %d -> %d" % [r["node0"], node1])
	ok(mem1 - int(r["mem0"]) <= MAX_STATIC_GROWTH_BYTES, "static memory growth %d bytes (<= %d)" % [mem1 - int(r["mem0"]), MAX_STATIC_GROWTH_BYTES])
	var us: Array = r["usec"]
	us.sort()
	var p95: int = us[int(us.size() * 0.95)] if us.size() > 0 else 0
	ok(p95 <= P95_SWAP_USEC, "swap logic p95 %d us <= %d us" % [p95, P95_SWAP_USEC])
	ok(_bus.published - pub0 >= n_swaps, "TWBus published >= 1 event per step (%d)" % (_bus.published - pub0))
	ok(_bus.dropped == 0, "TWBus dropped nothing")
	# one real pixel check (skipped if the headless renderer gives no image)
	await _pixel_check()
	print("TWSKINSOAK INFO soak p95=%d us, committed=%d, rejected=%d, objects %d->%d" % [p95, r["committed"], r["rejected"], r["obj0"], obj1])


func _pixel_check() -> void:
	var m: Dictionary = _manifests[0]                                  # real valid sample: rim = T3 of MOON
	var r: = TWSkinHostStub.swap(m, _data, _bus)
	var rim: Color = r["overrides"]["PLATE_RIM"]
	var pl: Control = _plates[0]
	var vp: = SubViewport.new()
	vp.size = Vector2i(328, 80)
	vp.transparent_bg = true
	vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	_host.add_child(vp)
	var par: = pl.get_parent()
	par.remove_child(pl)
	vp.add_child(pl)
	pl.position = Vector2.ZERO
	# bounded wait: a headless/dummy renderer may never emit frame_post_draw (then the pixel check goes to PENDING, the test must not hang)
	var drawn: Array = [false]
	RenderingServer.frame_post_draw.connect(func() -> void: drawn[0] = true, CONNECT_ONE_SHOT)
	var t0: = Time.get_ticks_msec()
	while not drawn[0] and Time.get_ticks_msec() - t0 < 1500:
		await _host.get_tree().process_frame
	var img: Image = null
	if drawn[0] and vp.get_texture() != null:
		img = vp.get_texture().get_image()
	vp.remove_child(pl)
	par.add_child(pl)
	vp.queue_free()
	if img == null or img.is_empty():
		todo("pixel check of the skinned TWPlate rim needs a rendering device (headless/dummy renderer returned no image)")
		return
	var px: = img.get_pixel(160, 1)
	ok(px.is_equal_approx(rim) or absf(px.r - rim.r) + absf(px.g - rim.g) + absf(px.b - rim.b) < 0.45, "skinned plate rim pixel %s near override %s" % [px.to_html(false), rim.to_html(false)])


func _replay() -> void:
	var a: = _run_sequence(SEED, 120, false)
	var b: = _run_sequence(SEED, 120, false)
	var c: = _run_sequence(SEED + 1, 120, false)
	ok(a["hash"] == b["hash"], "replay determinism: same seed -> same swap-history hash (%d)" % a["hash"])
	ok(a["hash"] != c["hash"], "different seed -> different hash (the hash is sensitive)")


func _reset() -> void:
	var rev: = TWSkin.revision
	TWSkin.reset()
	ok(TWSkin.current == "" and TWSkin.overrides().is_empty() and TWSkin.revision == rev + 1, "reset() returns to the base style and bumps the revision")
	ok(TWSkin.c("PLATE_RIM") == TWTokens.PLATE_RIM, "base token value restored")


func _real_host_present() -> bool:
	for c in ProjectSettings.get_global_class_list():
		if str(c.get("class", "")) == "TWSkinHost":
			return true
	return false


func _pending_list() -> void:
	# when the real host exists this test must be switched over: fail loudly instead of silently testing a stub
	ok(not _real_host_present(), "TWSkinHost now exists: replace TWSkinHostStub by TWSkinHost in skin_swap_soak.gd and shrink the pending list")
	todo("TWSkinHost state machine IDLE/PREPARING/STAGED/COMMITTING/ROLLBACK (SKIN_HUD_SYSTEM 2.6): 200 random swaps incl. tier changes, commit <= 400 ms")
	todo("TWPalette.resolve/mix parity: stub mixes in sRGB, spec says OKLab; test 200 refs against the golden table")
	todo("TWSkin.apply rejects locked tokens itself (gap G-01) or TWSkinHost.apply_locked_guard exists; AT-S23")
	todo("texture memory returns to baseline after 50 hero x skin swaps (AT-S30): needs TWSkinHost + packs; RSS <= +20 MB")
	todo("pack mount of .pck on a RELEASE Android build, 50 mounts (AT-S14): device only, see UNIFIED_QA_PLAN T-DEV-3")
	todo("slot-loss matrix: delete each slot of an SSR+ pack, UI still draws, TWAssets.problems has exactly the expected codes (AT-S03)")


func _cleanup() -> void:
	for p in _probes:
		p.queue_free()
	for p in _plates:
		p.queue_free()
	_probes.clear()
	_plates.clear()
	TWSkin.reset()
