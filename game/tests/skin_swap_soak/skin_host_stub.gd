class_name TWSkinHostStub
extends RefCounted

# INTERFACE STUB of the future TWSkinHost (design/specs/SKIN_HUD_SYSTEM.md section 2, package "P-skin"; branch claude/spec-skin).
# It is NOT a parallel skin system: it holds no state of its own and applies colours only through the existing shell layer
#   TWSkin.apply(id, {TOKEN: Color})  +  group "tw_skinned" -> _skin_changed()  +  TWBus events.
# What it adds is the part that does not exist on claude/integration yet and that the soak test must already pin down:
#   1. resolving the symbolic palette refs of a manifest ("H500", "T3", "NIGHT_700+T5@0.12") into Colors (TWPalette.resolve),
#   2. the slot whitelist (PALETTE_LOCK 6.2): unknown slot / locked slot / wrong HUD level / forbidden source are rejected,
#   3. ATOMICITY: either every slot resolves and the skin is applied, or nothing changes (TWSkin.current / revision untouched).
# When TWSkinHost lands the soak test switches to it (see TWSkinSwapSoak._real_host_present); this file is then deleted.
#
# Data comes from res://tests/fixtures/skins/ramps_min.json (GENERATED by tools/qa/build_skin_schema.py from the palette + schema).

const SLOT_NAME_RX: = "^[a-z][a-z0-9_]*$"


# JSON numbers are floats in Godot: [1.0, 2.0].has(1) is FALSE, so compare as ints (found by the soak test: synthetic manifests were empty)
static func has_level(levels: Array, level: int) -> bool:
	for x in levels:
		if int(x) == level:
			return true
	return false


static func _err(out: Dictionary, code: String, slot: String) -> void:
	(out["errors"] as Array).append(code)
	(out["detail"] as Array).append("%s %s" % [code, slot])


static func _is_raw_colour(v: String) -> bool:
	var s: = v.strip_edges()
	return s.begins_with("#") or s.to_lower().begins_with("rgb") or s.begins_with("Color") or s.begins_with("0x")


# "NIGHT_700+T5@0.12" -> {"base": "NIGHT_700", "tint": "T5", "t": 0.12};  "H300" -> {"base": "H300", "tint": "", "t": 0.0}
static func parse_ref(ref: String) -> Dictionary:
	if "+" in ref:
		var a: = ref.split("+")
		var b: = (a[1] as String).split("@")
		if b.size() != 2 or not (b[1] as String).is_valid_float():
			return {}
		return {"base": a[0], "tint": b[0], "t": float(b[1])}
	return {"base": ref, "tint": "", "t": 0.0}


static func color_of(name: String, hero: Dictionary, theme: Dictionary, neutrals: Dictionary) -> Variant:
	var rx: = RegEx.new()
	rx.compile("^H[1-9]00$")
	if rx.search(name) != null:
		return Color(str(hero[name])) if hero.has(name) else null
	rx.compile("^T[1-5]$")
	if rx.search(name) != null:
		return Color(str(theme[name])) if theme.has(name) else null
	return Color(str(neutrals[name])) if neutrals.has(name) else null


# -> {"ok": bool, "errors": [code...], "overrides": {TOKEN: Color}, "pending_tokens": [TOKEN...]}
# pending_tokens = slot constants that the slot table names but TWTokens does not have yet (RFC PAL-0001): TWSkin would count them as rejected.
static func resolve(manifest: Dictionary, data: Dictionary) -> Dictionary:
	var out: = {"ok": true, "errors": [], "detail": [], "overrides": {}, "pending_tokens": []}
	var pal: Dictionary = manifest.get("palette", {})
	var hero_id: String = str(pal.get("hero", ""))
	var theme_id: Variant = pal.get("theme", null)
	var hero: Dictionary = data["heroes"].get(hero_id, {})
	var theme: Dictionary = data["themes"].get(str(theme_id), {}) if theme_id != null else {}
	if hero.is_empty():
		out["errors"].append("SL-PAL-03")
	if theme_id != null and theme.is_empty():
		out["errors"].append("SL-PAL-03")
	var level: int = int(manifest.get("hud_level", -1))
	var slots: Dictionary = pal.get("slots", {})
	for slot in slots:
		var ref: String = str(slots[slot])
		if _is_raw_colour(ref):
			_err(out, "SL-PAL-01", slot)
			continue
		if data["locked_slots"].has(slot):
			_err(out, "SL-PAL-04", slot)
			continue
		if not data["slots"].has(slot):
			_err(out, "SL-PAL-02", slot)
			continue
		var rule: Dictionary = data["slots"][slot]
		if not has_level(rule["levels"], level):
			_err(out, "SL-PAL-02", "%s (level %d not in %s)" % [slot, level, rule["levels"]])
			continue
		var p: = parse_ref(ref)
		if p.is_empty() or not (rule["from"] as Array).has(p["base"]):
			_err(out, "SL-PAL-02", "%s (source %s not in %s)" % [slot, p.get("base", "?"), rule["from"]])
			continue
		var col: Variant = color_of(p["base"], hero, theme, data["neutrals"])
		if col == null:
			_err(out, "SL-PAL-03", slot)
			continue
		if p["tint"] != "":
			if not rule.has("mix") or not (rule["mix"] as Array).has(p["tint"]) or float(p["t"]) > float(rule["mix_max"]) + 0.000001:
				_err(out, "SL-PAL-02", slot)
				continue
			var tint: Variant = color_of(p["tint"], hero, theme, data["neutrals"])
			if tint == null:
				_err(out, "SL-PAL-03", slot)
				continue
			col = (col as Color).lerp(tint as Color, float(p["t"]))      # STUB: sRGB lerp; the real TWPalette.mix is OKLab (pending, see test)
		for tok in rule["tokens"]:
			if (data["locked_tokens"] as Array).has(tok):
				out["errors"].append("SL-PAL-04")
			elif TWSkin.has_token(tok):
				out["overrides"][tok] = col
			else:
				out["pending_tokens"].append(tok)
	out["ok"] = (out["errors"] as Array).is_empty()
	return out


# first error as "CODE slot" for readable test output
static func first_error(r: Dictionary) -> String:
	return str(r["errors"][0]) if not (r["errors"] as Array).is_empty() else ""


# Atomic swap. On error NOTHING changes. -> {"ok": bool, "code": String, "id": String, "overrides": Dictionary}
static func swap(manifest: Dictionary, data: Dictionary, bus: TWBus) -> Dictionary:
	var r: = resolve(manifest, data)
	if not r["ok"]:
		if bus != null:
			bus.publish({"t": "skin.failed", "skin": str(manifest.get("id", "")), "code": str(r["errors"][0])})
		return {"ok": false, "code": str(r["errors"][0]), "id": str(manifest.get("id", "")), "overrides": {}}
	TWSkin.apply(str(manifest["id"]), r["overrides"])
	if bus != null:
		bus.publish({"t": "skin.committed", "skin": str(manifest["id"]), "revision": TWSkin.revision})
	return {"ok": true, "code": "", "id": str(manifest["id"]), "overrides": r["overrides"], "pending_tokens": r["pending_tokens"]}
