class_name TWSkinHostStub
extends RefCounted

# INTERFACE STUB of the future TWSkinHost (design/specs/SKIN_HUD_SYSTEM.md section 2, package "P-skin"; branch claude/spec-skin).
# It is NOT a parallel skin system: it holds no global static Callable state (P96 / T19) and applies colours only through
#   TWSkin.apply(id, {TOKEN: Color})  +  group "tw_skinned" -> _skin_changed()  +  TWBus events.
# What it adds (P96 / UNIFIED_QA_PLAN Appendix R T11, T15d):
#   1. resolving the symbolic palette refs of a manifest ("H500", "T3", "NIGHT_700+T5@0.12") into Colors via OKLab mix (mix_oklab),
#   2. the slot whitelist (PALETTE_LOCK 6.2): unknown slot / locked slot / wrong HUD level / forbidden source are rejected,
#   3. ATOMICITY: either every slot resolves and the skin is applied, or nothing changes (TWSkin.current / revision untouched),
#   4. Host-owned Session tracking live skin-slot Texture2D instances (WeakRef-verified, 0 leaks across swaps) and host-owned
#      rejected_count that is NOT wiped by TWSkin.apply (T11).
# When TWSkinHost lands the soak test switches to it (see TWSkinSwapSoak._real_host_present); this file is then deleted.
#
# Data comes from res://tests/fixtures/skins/ramps_min.json (GENERATED by tools/qa/build_skin_schema.py from the palette + schema).

const SLOT_NAME_RX: = "^[a-z][a-z0-9_]*$"


class Session extends RefCounted:
	var active_textures: Dictionary = {}   # slot_id -> ImageTexture (Texture2D)
	var _tracked_refs: Array = []          # Array[WeakRef] of all ever-allocated live slot Texture2Ds
	var rejected_count: int = 0            # host-owned rejection counter (not wiped by TWSkin.apply, T11)
	var total_allocated: int = 0
	var total_released: int = 0

	func commit_textures(slots: Dictionary) -> void:
		var incoming: Dictionary = {}
		var keys: Array = slots.keys()
		keys.sort()
		for k in keys:
			var col: Color = slots[k] as Color
			var img: = Image.create(4, 4, false, Image.FORMAT_RGBA8)
			img.fill(col)
			var tex: Texture2D = ImageTexture.create_from_image(img)
			incoming[k] = tex
			_tracked_refs.append(weakref(tex))
			total_allocated += 1
		var prev_n: int = active_textures.size()
		active_textures = incoming
		total_released += prev_n
		_prune_dead_refs()

	func _prune_dead_refs() -> void:
		var alive: Array = []
		for wr in _tracked_refs:
			if (wr as WeakRef).get_ref() != null:
				alive.append(wr)
		_tracked_refs = alive

	func live_texture_count() -> int:
		_prune_dead_refs()
		return _tracked_refs.size()

	func active_slot_count() -> int:
		return active_textures.size()

	func clear() -> void:
		total_released += active_textures.size()
		active_textures.clear()
		_prune_dead_refs()


# JSON numbers are floats in Godot: [1.0, 2.0].has(1) is FALSE, so compare as ints (found by the soak test: synthetic manifests were empty)
static func has_level(levels: Array, level: int) -> bool:
	for x in levels:
		if int(x) == level:
			return true
	return false


static func _err(out: Dictionary, code: String, slot: String) -> void:
	(out["errors"] as Array).append(code)
	(out["detail"] as Array).append("%s %s" % [code, slot])


static func _is_raw_colour(v: String) -> bool:
	var s: = v.strip_edges()
	return s.begins_with("#") or s.to_lower().begins_with("rgb") or s.begins_with("Color") or s.begins_with("0x")


# ------------------------------------------------------------------ OKLab colour mix (T15d, Bjorn Ottosson 2020)

static func _srgb_to_lin(c: float) -> float:
	if c <= 0.04045:
		return c / 12.92
	return pow((c + 0.055) / 1.055, 2.4)


static func _lin_to_srgb(c: float) -> float:
	var v: = clampf(c, 0.0, 1.0)
	if v <= 0.0031308:
		return 12.92 * v
	return 1.055 * pow(v, 1.0 / 2.4) - 0.055


static func _cbrt(x: float) -> float:
	if x < 0.0:
		return -pow(-x, 1.0 / 3.0)
	return pow(x, 1.0 / 3.0)


static func srgb_to_oklab(c: Color) -> Vector3:
	var r: = _srgb_to_lin(c.r)
	var g: = _srgb_to_lin(c.g)
	var b: = _srgb_to_lin(c.b)
	var l_: = _cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
	var m_: = _cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
	var s_: = _cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
	return Vector3(
		0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
		1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
		0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
	)


static func oklab_to_srgb(lab: Vector3, alpha: float = 1.0) -> Color:
	var l_: = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z
	var m_: = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z
	var s_: = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z
	var l: = l_ * l_ * l_
	var m: = m_ * m_ * m_
	var s: = s_ * s_ * s_
	var r: = +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
	var g: = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
	var b: = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
	return Color(_lin_to_srgb(r), _lin_to_srgb(g), _lin_to_srgb(b), alpha)


static func mix_oklab(a: Color, b: Color, t: float) -> Color:
	var la: = srgb_to_oklab(a)
	var lb: = srgb_to_oklab(b)
	return oklab_to_srgb(la.lerp(lb, t), lerpf(a.a, b.a, t))


static func oklab_distance(a: Color, b: Color) -> float:
	return srgb_to_oklab(a).distance_to(srgb_to_oklab(b))


# "NIGHT_700+T5@0.12" -> {"base": "NIGHT_700", "tint": "T5", "t": 0.12};  "H300" -> {"base": "H300", "tint": "", "t": 0.0}
static func parse_ref(ref: String) -> Dictionary:
	if "+" in ref:
		var a: = ref.split("+")
		var b: = (a[1] as String).split("@")
		if b.size() != 2 or not (b[1] as String).is_valid_float():
			return {}
		return {"base": a[0], "tint": b[0], "t": float(b[1])}
	return {"base": ref, "tint": "", "t": 0.0}


static func color_of(name: String, hero: Dictionary, theme: Dictionary, neutrals: Dictionary) -> Variant:
	var rx: = RegEx.new()
	rx.compile("^H[1-9]00$")
	if rx.search(name) != null:
		return Color(str(hero[name])) if hero.has(name) else null
	rx.compile("^T[1-5]$")
	if rx.search(name) != null:
		return Color(str(theme[name])) if theme.has(name) else null
	return Color(str(neutrals[name])) if neutrals.has(name) else null


# -> {"ok": bool, "errors": [code...], "overrides": {TOKEN: Color}, "slot_colors": {slot: Color}, "pending_tokens": [TOKEN...]}
# pending_tokens = slot constants that the slot table names but TWTokens does not have yet (RFC PAL-0001): TWSkin would count them as rejected.
static func resolve(manifest: Dictionary, data: Dictionary) -> Dictionary:
	var out: = {"ok": true, "errors": [], "detail": [], "overrides": {}, "slot_colors": {}, "pending_tokens": []}
	var pal: Dictionary = manifest.get("palette", {})
	var hero_id: String = str(pal.get("hero", ""))
	var theme_id: Variant = pal.get("theme", null)
	var hero: Dictionary = data["heroes"].get(hero_id, {})
	var theme: Dictionary = data["themes"].get(str(theme_id), {}) if theme_id != null else {}
	if hero.is_empty():
		out["errors"].append("SL-PAL-03")
	if theme_id != null and theme.is_empty():
		out["errors"].append("SL-PAL-03")
	var level: int = int(manifest.get("hud_level", -1))
	var slots: Dictionary = pal.get("slots", {})
	for slot in slots:
		var ref: String = str(slots[slot])
		if _is_raw_colour(ref):
			_err(out, "SL-PAL-01", slot)
			continue
		if data["locked_slots"].has(slot):
			_err(out, "SL-PAL-04", slot)
			continue
		if not data["slots"].has(slot):
			_err(out, "SL-PAL-02", slot)
			continue
		var rule: Dictionary = data["slots"][slot]
		if not has_level(rule["levels"], level):
			_err(out, "SL-PAL-02", "%s (level %d not in %s)" % [slot, level, rule["levels"]])
			continue
		var p: = parse_ref(ref)
		if p.is_empty() or not (rule["from"] as Array).has(p["base"]):
			_err(out, "SL-PAL-02", "%s (source %s not in %s)" % [slot, p.get("base", "?"), rule["from"]])
			continue
		var col: Variant = color_of(p["base"], hero, theme, data["neutrals"])
		if col == null:
			_err(out, "SL-PAL-03", slot)
			continue
		if p["tint"] != "":
			if not rule.has("mix") or not (rule["mix"] as Array).has(p["tint"]) or float(p["t"]) > float(rule["mix_max"]) + 0.000001:
				_err(out, "SL-PAL-02", slot)
				continue
			var tint: Variant = color_of(p["tint"], hero, theme, data["neutrals"])
			if tint == null:
				_err(out, "SL-PAL-03", slot)
				continue
			col = mix_oklab(col as Color, tint as Color, float(p["t"]))
		out["slot_colors"][slot] = col
		for tok in rule["tokens"]:
			if (data["locked_tokens"] as Array).has(tok):
				out["errors"].append("SL-PAL-04")
			elif TWSkin.has_token(tok):
				out["overrides"][tok] = col
			else:
				out["pending_tokens"].append(tok)
	out["ok"] = (out["errors"] as Array).is_empty()
	return out


# first error as "CODE slot" for readable test output
static func first_error(r: Dictionary) -> String:
	return str(r["errors"][0]) if not (r["errors"] as Array).is_empty() else ""


# Atomic swap. On error NOTHING changes (neither TWSkin nor session textures); session.rejected_count increments.
# -> {"ok": bool, "code": String, "id": String, "overrides": Dictionary}
static func swap(manifest: Dictionary, data: Dictionary, bus: TWBus, session: Session = null) -> Dictionary:
	var r: = resolve(manifest, data)
	if not r["ok"]:
		if session != null:
			session.rejected_count += 1
		if bus != null:
			bus.publish({"t": "skin.failed", "skin": str(manifest.get("id", "")), "code": str(r["errors"][0])})
		return {"ok": false, "code": str(r["errors"][0]), "id": str(manifest.get("id", "")), "overrides": {}}
	TWSkin.apply(str(manifest["id"]), r["overrides"])
	if session != null:
		session.commit_textures(r["slot_colors"])
	if bus != null:
		bus.publish({"t": "skin.committed", "skin": str(manifest["id"]), "revision": TWSkin.revision})
	return {"ok": true, "code": "", "id": str(manifest["id"]), "overrides": r["overrides"], "pending_tokens": r["pending_tokens"]}
