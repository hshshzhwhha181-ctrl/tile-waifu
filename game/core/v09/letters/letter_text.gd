# «1 день», «3 дня», «5 дней», «21 день»
static func days_word(n: int) -> String:
	var m10: = n % 10
	var m100: = n % 100
	var w: = "дней"
	if m10 == 1 and m100 != 11:
		w = "день"
	elif m10 >= 2 and m10 <= 4 and (m100 < 12 or m100 > 14):
		w = "дня"
	return "%d %s" % [n, w]


static func variants(h: String, ev: String) -> Array:
	return LETTERS.get(h, {}).get(ev, [])


static func fill(s: String, vars: Dictionary) -> String:
	var nick: = G.nick() if G.has_method("nick") else ""
	if nick == "":
		nick = "Гость"
	var out: = s.replace("{nick}", nick)
	out = out.replace("{combo}", str(int(vars.get("combo", 0))))
	out = out.replace("{rank}", str(vars.get("rank", "")))
	out = out.replace("{days}", days_word(int(vars.get("days", 2))))
	# a sentence may open with the placeholder: «3 дня без тебя» stays as is, a nick keeps its own case
	return out
