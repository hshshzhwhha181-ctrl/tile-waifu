static func pool(h: String, zone: String) -> Array:
	return LINES.get(h if LINES.has(h) else "mc", {}).get(zone, [])


# {text, emo, voice (res path or "")} of pool entry i
static func entry(h: String, zone: String, i: int) -> Dictionary:
	var p: = pool(h, zone)
	if p.is_empty():
		return {}
	var e: Dictionary = p[posmod(i, p.size())]
	var hh: = h if LINES.has(h) else "mc"
	if e.has("v"):
		var kind: String = e.v[0]
		var idx: int = int(e.v[1])
		var arr: Array = Sfx.VOICED.get(hh, {}).get(kind, [])
		if idx < arr.size():
			var path: = "res://assets/voice/%s_%s%d.mp3" % [hh, kind, idx + 1]
			return {"text": str(arr[idx]), "emo": str(e.get("e", "happy")), "voice": path if ResourceLoader.exists(path) else ""}
		return {}
	return {"text": str(e.get("t", "")), "emo": str(e.get("e", "happy")), "voice": ""}
