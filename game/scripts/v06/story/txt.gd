static func line(hero: String, kind: String) -> String:
	var h: Dictionary = LINES.get(hero, LINES.mc)
	var arr: Array = h.get(kind, LINES.mc.get(kind, []))
	if arr.is_empty():
		return ""
	return arr[randi() % arr.size()]



