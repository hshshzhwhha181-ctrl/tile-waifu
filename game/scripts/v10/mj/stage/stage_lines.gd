	"nova": "9169700e-3fcf-466a-8ad2-97876a89cf25",
}

# a heroine outside the five founders (wave 1 and later) borrows the closest founder's lines until she has her own
const FALLBACK: = {"tsubame": "hana", "miel": "mc", "kohaku": "yue", "shirin": "mc", "zlata": "rin"}


static func hero_key(hero: String) -> String:
	if LINES.has(hero):
		return hero
	return String(FALLBACK.get(hero, "mc"))


static func variants(hero: String, ev: String) -> Array:
	return (LINES[hero_key(hero)] as Dictionary).get(ev, [])


static func voice_path(hero: String, ev: String, n: int) -> String:
	return "res://assets/v10/mj/stage/voice/%s_%s_%d.ogg" % [hero_key(hero), ev, n]


static func all_subtitles() -> Array:
	var out: = []
	for h in LINES:
		for ev in LINES[h]:
			for v in LINES[h][ev]:
				out.append(String(v[0]))
	return out
