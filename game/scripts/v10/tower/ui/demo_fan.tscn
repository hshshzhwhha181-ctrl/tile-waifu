[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="runner"]
script/source = "extends Control

# Runner of part C: loads demo_fan.gd at run time, so a parse error ends the process at once (exit 3)
# instead of leaving an idle headless Godot holding /tmp/tw-godot.lock.
func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var s = load(\"res://scripts/v10/tower/ui/demo_fan.gd\")
	if s == null or not (s as GDScript).can_instantiate():
		print(\"FAN_UI_SELFTEST parse error\")
		get_tree().quit(3)
		return
	var n: Control = s.new()
	n.name = \"DemoFan\"
	add_child(n)
"

[node name="DemoFanRunner" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("runner")
