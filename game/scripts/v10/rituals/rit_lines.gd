static func pick(group: String, h: String, seed: = -1) -> String:
	var g: Dictionary = L.get(group, {})
	var arr: Array = g.get(h, g.get("mc", [""]))
	if arr.is_empty():
		return ""
	var i: = (seed if seed >= 0 else randi()) % arr.size()
	return str(arr[i])


# Russian plural: {p:одна|две|пять} after {n}
static func plural(n: int, one: String, few: String, many: String) -> String:
	var a: = absi(n) % 100
	if a >= 11 and a <= 14:
		return many
	match a % 10:
		1:
			return one
		2, 3, 4:
			return few
	return many


static func fmt(text: String, n: int) -> String:
	var out: = text.replace("{n}", str(n))
	var rx: = RegEx.create_from_string("\\{p:([^|}]*)\\|([^|}]*)\\|([^|}]*)\\}")
	for m in rx.search_all(out):
		out = out.replace(m.get_string(0), plural(n, m.get_string(1), m.get_string(2), m.get_string(3)))
	return out


static func all() -> Array:
	var out: = []
	for g in L:
		for h in L[g]:
			for s in L[g][h]:
				out.append(fmt(str(s).replace("{voc}", ", Аня"), 7))
	for k in FACTS:
		out.append(fmt(str(FACTS[k]), 7))
	return out
