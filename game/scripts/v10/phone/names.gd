static func count() -> int:
	return NAMES.size()


static func find(nom: String) -> Array:
	for r in NAMES:
		if r[0] == nom:
			return r
	return []


static func voc(nom: String) -> String:
	var r: = find(nom)
	return str(r[1]) if not r.is_empty() else nom


static func gender(nom: String) -> String:
	var r: = find(nom)
	return str(r[2]) if not r.is_empty() else "m"


# names of one gender, alphabetical (the picker shows two columns of chips)
static func by_gender(g: String) -> Array:
	var out: = []
	for r in NAMES:
		if r[2] == g:
			out.append(r)
	out.sort_custom(func(a, b): return str(a[0]) < str(b[0]))
	return out


# the save record S.v10_phone.name = {nom, voc, g}; nom "" = «Не называть»
static func record(nom: String, g: = "") -> Dictionary:
	if nom == "":
		return {"nom": "", "voc": "", "g": g if g != "" else "m"}
	return {"nom": nom, "voc": voc(nom), "g": gender(nom)}
