static func room_line(h: String) -> String:
	var lv: = G.aff_level(h)
	var tier: = 0 if lv < 4 else (1 if lv < 7 else 2)
	var arr: Array = ROOM_LINES[h][tier]
	return arr[randi() % arr.size()]


