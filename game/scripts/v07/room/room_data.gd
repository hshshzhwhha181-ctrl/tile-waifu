static func gift(id: String) -> Dictionary:
	for g in GIFTS:
		if g.id == id:
			return g
	return {}

static func taste(h: String, gid: String) -> String:
	if gid in PREFS[h].love:
		return "love"
	if gid in PREFS[h].like:
		return "like"
	return "plain"

