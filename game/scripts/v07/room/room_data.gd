static func st() -> Dictionary:
	if not G.S.has("v7_room") or not (G.S.v7_room is Dictionary):
		G.S["v7_room"] = {}
	var s: Dictionary = G.S.v7_room
	for k in ["gifts", "known", "places", "photos", "seen", "last_mom"]:
		if not s.has(k) or not (s[k] is Dictionary):
			s[k] = {}
	if not s.has("day"):
		s["day"] = ""
	var today: = G.today()
	if s.day != today:
		s.day = today
		s["invites"] = FREE_INVITES
		s["bought"] = 0
		s.gifts = {}
	return s

static func gifts_left(h: String) -> int:
	return GIFTS_PER_DAY - int(st().gifts.get(h, 0))

static func invites() -> int:
	return int(st().get("invites", FREE_INVITES))

static func known(h: String, gid: String) -> bool:
	return st().known.get(h, {}).has(gid)

static func place_known(h: String, pid: String) -> bool:
	return st().places.get(h, {}).has(pid)

static func photos(h: String) -> int:
	return st().photos.get(h, {}).size()

static func mark(dict_key: String, h: String, k: String) -> void :
	var s: = st()
	var d: Dictionary = s[dict_key].get(h, {})
	d[k] = true
	s[dict_key][h] = d


static func fresh_scenes(h: String) -> Array:
	var out: = []
	for id in V7RoomScenes.for_hero(h):
		if G.aff_level(h) >= int(V7RoomScenes.SCENES[id].lv) and not st().seen.has(id):
			out.append(id)
	return out


static func any_fresh() -> bool:
	for h in G.HERO_ORDER:
		if G.hero_unlocked(h) and fresh_scenes(h).size() > 0:
			return true
	return false


static func next_unlock(h: String) -> String:
	var lv: = G.aff_level(h)
	for id in V7RoomScenes.for_hero(h):
		var need: = int(V7RoomScenes.SCENES[id].lv)
		if need > lv:
			return "Симпатия %d · «%s»" % [need, V7RoomScenes.SCENES[id].title]
	return "Все сцены открыты"


static func build_date(h: String, pid: String) -> Dictionary:
	var p: Dictionary = PLACES[pid]
	var pool: Array = range(MOMENTS[h].size())
	var last: Array = st().last_mom.get(h, [])
	var fresh: = pool.filter( func(i): return not i in last)
	if fresh.size() < 2:
		fresh = pool.duplicate()
	fresh.shuffle()
	var pick: Array = fresh.slice(0, 2)
	st().last_mom[h] = pick
	var lines: = [["", p.intro], [h, OPENERS[h][pid], "happy"]]
	for i in pick:
		var m: Dictionary = MOMENTS[h][i]
		var opts: Array = m.a.duplicate()
		opts.shuffle()
		lines.append({"who": h, "q": m.q, "date": opts})
	return {"bg_path": p.bg, "fx": p.fx, "focus": p.focus, "title": "Свидание · " + p.name, "cast": [h], "lines": lines}


# ---- 0.8 «Письма»: messages the heroines really sent (after dates), newest last. No fake entries.
const MAIL_MAX: = 30

static func mail() -> Array:
	var s: = st()
	if not (s.get("mail") is Array):
		s["mail"] = []
	return s.mail

static func add_mail(h: String, text: String, kind: = "date", extra: = "") -> void :
	var m: = mail()
	m.append({"h": h, "text": text, "kind": kind, "extra": extra, "t": V10Meta.now_unix(), "read": false})
	while m.size() > MAIL_MAX:
		m.pop_front()

static func unread_mail() -> int:
	var n: = 0
	for e in mail():
		if e is Dictionary and not bool(e.get("read", false)):
			n += 1
	return n

static func mark_mail_read() -> void :
	for e in mail():
		if e is Dictionary:
			e["read"] = true
