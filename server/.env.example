# Tile Waifu 0.12.0 — сервер. Скопируйте в .env (рядом с server.mjs) и раскомментируйте нужное.
# server.mjs сам читает .env при запуске (process.loadEnvFile), npm-пакеты не нужны.

# --- Основное ---
# PORT=8787
# HOST=0.0.0.0
# Путь к SQLite-базе (каталог создаётся автоматически)
# DB_PATH=./data/tilewaifu.db
# Публичный адрес сервера БЕЗ слэша в конце: из него строятся redirect_uri для OAuth
# (https://ВАШ-ДОМЕН/auth/yandex/callback и т.д.)
# PUBLIC_URL=https://tw.example.ru
# 1 = тестовый вход /api/v1/auth/oauth/sandbox (по умолчанию 1 локально и 0 при NODE_ENV=production). На проде — 0!
# ALLOW_DEV_OAUTH=0
# NODE_ENV=production
# QUIET=1                       # не писать лог в stdout
# TRUST_PROXY=1                 # брать IP клиента из X-Forwarded-For (за nginx); 0 = не доверять

# --- PvP ---
# BOT_WAIT_MS=6000              # через сколько мс без соперника-человека дать бота
# BOT_MIN_FINISH_MS=45000       # бот не заканчивает раньше
# BOT_AVATARS=mc                # список id аватаров ботов через запятую

# --- Лимиты (запросов в минуту с одного IP) ---
# RATE_LIMIT_AUTH=60
# RATE_LIMIT_API=600

# --- Яндекс ID (https://oauth.yandex.ru/client/new) ---
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# --- Google (https://console.cloud.google.com/apis/credentials) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- VK ID (https://id.vk.com/about/business/go) ---
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=             # необязателен: VK ID работает по PKCE

# --- Telegram Login Widget (бот от @BotFather, домен через /setdomain) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_NAME=TileWaifuBot   # username бота без @, нужен для страницы /auth/telegram/start
